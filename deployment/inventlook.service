[Unit]
Description=Inventlook Spring Boot Application
After=syslog.target network.target mysql.service

[Service]
User=root
WorkingDirectory=/opt/inventlook
ExecStart=/usr/bin/java -jar /opt/inventlook/target/inventlook-0.0.1-SNAPSHOT.jar --server.address=127.0.0.1
SuccessExitStatus=143
Restart=always
RestartSec=10

# Security
NoNewPrivileges=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=inventlook

[Install]
WantedBy=multi-user.target
