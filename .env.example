# ===================================================
# ARCHIVO DE EJEMPLO - VARIABLES DE ENTORNO
# ===================================================
# Copia este archivo como .env y completa con tus valores reales
# IMPORTANTE: .env NO debe subirse a GitHub (ya está en .gitignore)

# Base de datos MySQL (Producción)
DB_PASSWORD=tu_password_mysql_aqui

# Configuración de correo Gmail
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion_gmail

# Notas:
# - Para obtener contraseña de aplicación de Gmail:
#   1. Ve a https://myaccount.google.com/security
#   2. Habilita verificación en 2 pasos
#   3. Genera una "contraseña de aplicación"
#   4. Usa esa contraseña aquí (no tu contraseña normal)
